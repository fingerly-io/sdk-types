{
  "name": "@fingerly/types",
  "version": "0.1.1",
  "publishConfig": { "access": "public" },
  "packageManager": "pnpm@9.0.0",
  "description": "Shared TypeScript contracts for every Fingerly SDK",
  "license": "Apache-2.0",
  "repository": {"type": "git", "url": "https://github.com/fingerly-io/sdk-types.git"},
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
